# API
PORT=3001
JWT_SECRET=lupriv_dev_secret_change_me
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# MySQL (docker-compose maps host 3307 -> container 3306)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=lupriv
DB_PASSWORD=lupriv_pass
DB_NAME=lupriv_new

# Legacy: allow ?branchId= on kiosk. Client now prefers localStorage (lupriv_branch_id);
# server always accepts explicit branchId; IP is fallback only.
KIOSK_ALLOW_BRANCH_QUERY=1
# Cron/HTTP secret for POST /api/auto-logout/run (header X-Auto-Logout-Secret or ?secret=)
AUTO_LOGOUT_SECRET=change_me_auto_logout_secret
