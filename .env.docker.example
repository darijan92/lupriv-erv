# Copy values into project-root `.env` (compose reads it for ${VAR} substitution).
# Do not commit real secrets. Inside containers, DB_HOST/DB_PORT are set in
# docker-compose.yml (mysql:3306). Host `npm run dev` uses DB_HOST=127.0.0.1:3307
# via docker-compose.dev.yml.

# --- MySQL (compose + api) ---
MYSQL_ROOT_PASSWORD=change_me_strong_root_password
DB_USER=lupriv
DB_PASSWORD=change_me_strong_db_password
DB_NAME=lupriv_new

# --- API ---
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=12h
# Local Docker web: http://localhost:8080
# VPS production: https://your.domain
CORS_ORIGIN=https://your.domain
AUTO_LOGOUT_SECRET=change_me_long_random_auto_logout_secret
# The API refuses to start while the secrets above are left at these example values.
# Generate: openssl rand -hex 32

# Proxies in front of the API: 1 = web nginx only, 2 = Caddy → web nginx (VPS)
TRUST_PROXY_HOPS=2
# Voditelji may edit the previous month until this day of the month (0 = no lock)
HOURS_EDIT_LOCK_DAY=5
# Minutes added to kraj_rv when auto-logout closes a forgotten day session (old app: 60)
AUTO_LOGOUT_EXTRA_MINUTES=0
# A session from an earlier day that is open longer than this is a forgotten check-out:
# at the next check-in/check-out it is closed by the auto-logout rules, not "until now" (8–48)
MAX_OPEN_SESSION_HOURS=16
