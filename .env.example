# API (host npm + Docker compose ${VAR} substitution)
PORT=3001
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
# Host Vite origins; for Docker web also include http://localhost:8080
# Production VPS: https://your.domain
CORS_ORIGIN=http://localhost:5173,http://localhost:5175,http://localhost:8080

# MySQL — host npm against Docker MySQL (docker-compose.dev.yml publishes 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=lupriv
DB_PASSWORD=lupriv_pass
DB_NAME=lupriv_new
MYSQL_ROOT_PASSWORD=rootpass

# Cron/HTTP secret for POST /api/auto-logout/run (header X-Auto-Logout-Secret or JSON body "secret")
AUTO_LOGOUT_SECRET=change_me_auto_logout_secret
# Local `npm run docker:up` runs with NODE_ENV=production, which refuses the default secrets
# above. Allow them locally only — never set this on the VPS.
ALLOW_INSECURE_DEFAULTS=1
# Voditelji may edit the previous month until this day of the month (0 = no lock)
HOURS_EDIT_LOCK_DAY=5
# Minutes added to kraj_rv when auto-logout closes a forgotten day session (old app: 60)
AUTO_LOGOUT_EXTRA_MINUTES=0
# A session from an earlier day that is open longer than this is a forgotten check-out:
# at the next check-in/check-out it is closed by the auto-logout rules, not "until now" (8–48)
MAX_OPEN_SESSION_HOURS=16
